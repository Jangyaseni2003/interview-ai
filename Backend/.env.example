MONGO_URI=mongodb://localhost:27017/interview-ai
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# The deployed frontend's origin, used for CORS. Leave unset locally (defaults to http://localhost:5173).
FRONTEND_URL=

# Set to "production" when deployed — enables secure/cross-site cookies. Leave unset locally.
NODE_ENV=

# Port the server listens on. Most hosts (Render, etc.) inject this automatically — leave unset locally to default to 3001.
PORT=

# Max AI-powered calls (report generation, resume PDF, section regeneration, mock feedback) a user can make per 24h
DAILY_AI_LIMIT=20

# Optional: real SMTP config for emailing resumes. If left unset, a temporary
# Ethereal test inbox is used automatically (a preview link is returned instead of a real email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Interview AI <no-reply@interview-ai.local>
